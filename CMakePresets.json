{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "vcpkg (base)",
      "description": "Base preset that wires the vcpkg toolchain via $env{VCPKG_ROOT}",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AEOLION_USE_LAPACK": "ON",
        "AEOLION_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "inherits": "vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64 (vcpkg)",
      "inherits": "vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc-sanitizer-base",
      "description": "Shared settings for the ASan/UBSan presets the Sanitizers workflow runs. Deliberately does NOT inherit 'vcpkg': a sanitizer run wants LAPACK, nlohmann_json and spdlog from the system so the job does not rebuild OpenBLAS and reference LAPACK (Fortran) from source on every push. The viewer is off for the same reason -- glad and imgui have no system CONFIG package.",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "AEOLION_BUILD_TESTS": "ON",
        "AEOLION_BUILD_VIEWER": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "Linux x64 (GCC + AddressSanitizer)",
      "inherits": "gcc-sanitizer-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "gcc-ubsan",
      "displayName": "Linux x64 (GCC + UndefinedBehaviorSanitizer)",
      "inherits": "gcc-sanitizer-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "gcc-asan",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-ubsan",
      "configurePreset": "gcc-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "gcc-asan",
      "configurePreset": "gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-ubsan",
      "configurePreset": "gcc-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
