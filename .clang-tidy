# Disabled beyond the defaults, because they fight deliberate idioms here:
#   math-missing-parentheses   -- formulas are kept in textbook notation
#   use-designated-initializers, use-auto, enum-size -- style only
#   avoid-c-arrays             -- fixed-size scratch arrays in hot kernels
#   raw-string-literal         -- escaped JSON/CSV emitters read fine
#   security.FloatLoopCounter  -- alpha sweeps carry an explicit end tolerance
#   avoid-endl                 -- progress lines in long sweeps flush on purpose
#   avoid-nested-conditional-operator -- threshold ladders read as a table
#   return-braced-init-list    -- `return Vec3(-v.x, v.y, -v.z)` names the type
# readability-function-size still reports (AV Rules 1 and 3) but does not
# fail the job: the large solver drivers are single-pass by design.
---
Checks: >
    -*,
    clang-diagnostic-*,
    -clang-diagnostic-unknown-warning-option,
    -clang-diagnostic-enum-constexpr-conversion,
    clang-analyzer-*,
    -clang-analyzer-cplusplus*,
    -clang-analyzer-optin.core.EnumCastOutOfRange,
    -clang-analyzer-security.FloatLoopCounter,
    bugprone-*,
    -bugprone-easily-swappable-parameters,
    -bugprone-exception-escape,
    -bugprone-chained-comparison,
    cppcoreguidelines-*,
    -cppcoreguidelines-macro-usage,
    -cppcoreguidelines-pro-type-static-cast-downcast,
    -cppcoreguidelines-pro-type-vararg,
    -cppcoreguidelines-pro-type-union-access,
    -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
    -cppcoreguidelines-pro-bounds-pointer-arithmetic,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-non-private-member-variables-in-classes,
    -cppcoreguidelines-avoid-do-while,
    -cppcoreguidelines-owning-memory,
    misc-*,
    -misc-non-private-member-variables-in-classes,
    -misc-no-recursion,
    -misc-const-correctness,
    -misc-include-cleaner,
    -misc-use-internal-linkage,
    -misc-use-anonymous-namespace,
    modernize-*,
    -modernize-use-trailing-return-type,
    -modernize-use-nodiscard,
    -modernize-type-traits,
    performance-*,
    readability-*,
    -readability-braces-around-statements,
    -readability-named-parameter,
    -readability-magic-numbers,
    -readability-isolate-declaration,
    -readability-function-cognitive-complexity,
    -readability-use-anyofallof,
    -readability-identifier-length,
    -readability-suspicious-call-argument,
    -readability-implicit-bool-conversion,
    -readability-math-missing-parentheses,
    -modernize-use-designated-initializers,
    -modernize-avoid-c-arrays,
    -cppcoreguidelines-avoid-c-arrays,
    -modernize-raw-string-literal,
    -modernize-use-auto,
    -performance-enum-size,
    -performance-avoid-endl,
    -readability-avoid-nested-conditional-operator,
    -modernize-return-braced-init-list
WarningsAsErrors: >
    -*,
    clang-diagnostic-*,
    -clang-diagnostic-unknown-warning-option,
    -clang-diagnostic-enum-constexpr-conversion,
    clang-analyzer-*,
    -clang-analyzer-cplusplus*,
    -clang-analyzer-optin.core.EnumCastOutOfRange,
    -clang-analyzer-security.FloatLoopCounter,
    bugprone-*,
    -bugprone-easily-swappable-parameters,
    -bugprone-exception-escape,
    -bugprone-chained-comparison,
    cppcoreguidelines-*,
    -cppcoreguidelines-macro-usage,
    -cppcoreguidelines-pro-type-static-cast-downcast,
    -cppcoreguidelines-pro-type-vararg,
    -cppcoreguidelines-pro-type-union-access,
    -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
    -cppcoreguidelines-pro-bounds-pointer-arithmetic,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-non-private-member-variables-in-classes,
    -cppcoreguidelines-avoid-do-while,
    -cppcoreguidelines-owning-memory,
    misc-*,
    -misc-non-private-member-variables-in-classes,
    -misc-no-recursion,
    -misc-const-correctness,
    -misc-include-cleaner,
    -misc-use-internal-linkage,
    -misc-use-anonymous-namespace,
    modernize-*,
    -modernize-use-trailing-return-type,
    -modernize-use-nodiscard,
    -modernize-type-traits,
    performance-*,
    readability-*,
    -readability-braces-around-statements,
    -readability-named-parameter,
    -readability-magic-numbers,
    -readability-isolate-declaration,
    -readability-function-cognitive-complexity,
    -readability-use-anyofallof,
    -readability-identifier-length,
    -readability-suspicious-call-argument,
    -readability-implicit-bool-conversion,
    -readability-math-missing-parentheses,
    -modernize-use-designated-initializers,
    -modernize-avoid-c-arrays,
    -cppcoreguidelines-avoid-c-arrays,
    -modernize-raw-string-literal,
    -modernize-use-auto,
    -performance-enum-size,
    -performance-avoid-endl,
    -readability-avoid-nested-conditional-operator,
    -modernize-return-braced-init-list,
    -readability-function-size
HeaderFilterRegex: '.*/Aeolion/(DragEstimate|Geometry|Lattice|Logger|Math|PanelBuilder|Solver)/.*'
FormatStyle:     none
CheckOptions:
  - key:             modernize-use-override.AllowOverrideAndFinal
    value:           '1'
  - key:             cppcoreguidelines-explicit-virtual-functions.AllowOverrideAndFinal
    value:           '1'
  - key:             cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value:           '1'
  - key:             cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value:           '1'
    # ignore nlohmann/json and spdlog internals until added to IWYU, and also
    # ignore internal GCC headers (bits/)
  - key:             misc-include-cleaner.IgnoreHeaders
    value:           'nlohmann/detail/.*|spdlog/details/.*|bits/.*|external/.*'
    # AV Rule 1: functions shall not exceed 200 LSLOC.
  - key:             readability-function-size.LineThreshold
    value:           '200'
    # AV Rule 3: cyclomatic complexity of any function shall be 20 or less.
  - key:             readability-function-size.CyclomaticComplexityThreshold
    value:           '20'
    # DeMorgan rewrites turn `!(lo <= x && x <= hi)` range checks into a
    # harder-to-read disjunction; the rest of simplify-boolean-expr stays.
  - key:             readability-simplify-boolean-expr.SimplifyDeMorgan
    value:           'false'
ExtraArgs:
  - '-std=c++23'